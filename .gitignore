# ---------------------------------------------------------------------------
# CampFreedivePH monorepo: camp-freedive-ph (Laravel), safety-forecast and
# demand-forecast (Python). Each project also has its own .gitignore.
# ---------------------------------------------------------------------------

# Python environments, caches and tooling
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.benchmarks/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets (never commit real credentials)
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# safety-forecast: large or generated files kept out of git
#  - models/ is stored with Git LFS (see .gitattributes)
#  - archive/ holds retired models and old data; history already has it
#  - reports/ subfolders below are regenerated by the training scripts.
#    reports/autogluon_benchmarks and reports/baselines stay tracked because
#    the model service reads them while it runs.
safety-forecast/archive/
safety-forecast/reports/figures/
safety-forecast/reports/with_lags_full/
safety-forecast/reports/with_lags_non_provisional/
safety-forecast/reports/data_audits/
