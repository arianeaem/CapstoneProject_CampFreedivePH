<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Never call PayMongo from tests; tests that need the API set a fake key and use Http::fake().
             force="true" so parent-shell env vars (e.g. from a prior race run) cannot leak in. -->
        <env name="PAYMONGO_SECRET_KEY" value="" force="true"/>
        <env name="PAYMONGO_PUBLIC_KEY" value="" force="true"/>
        <env name="PAYMONGO_WEBHOOK_SIGNATURE_SECRET" value="" force="true"/>
        <env name="PAYMONGO_BASE_URL" value="https://api.paymongo.com/v1" force="true"/>
        <!-- Synthetic ML API token for the ML sync tests. Without it the tests used the developer's real token from
             .env, and failed in CI where .env.example leaves it empty (the cause of the failing "Laravel CI" runs). -->
        <env name="ML_API_TOKEN" value="synthetic-test-ml-token" force="true"/>
        <!-- Test runs must not write synthetic accounts, links or tokens into storage/logs -->
        <env name="LOG_CHANNEL" value="null"/>
    </php>
</phpunit>
