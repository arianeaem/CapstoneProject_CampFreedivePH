APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayMongo API Configuration
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_WEBHOOK_SIGNATURE_SECRET=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1

# Machine Learning Service & Forecast Sync Configuration
ML_API_TOKEN=
ML_SAFETY_SERVICE_URL=http://127.0.0.1:8001
ML_SAFETY_ENABLED=true
# ML_DEMAND_SCHEDULE_ENABLED=false
# ML_DEMAND_RETRAIN_SCRIPT=../demand-forecast/retrain_pipeline.py
# ML_DEMAND_WORKING_DIR=../demand-forecast
PAYMONGO_CURRENCY=PHP

# Rate Limiting Configuration (Attempts / Decay Windows)
# RATE_LIMIT_GENERAL_API=100
# RATE_LIMIT_GENERAL_API_DECAY=15
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_DECAY=15
# RATE_LIMIT_PASSWORD_RESET=5
# RATE_LIMIT_PASSWORD_RESET_DECAY=15
# RATE_LIMIT_BOOKING=10
# RATE_LIMIT_BOOKING_DECAY=15
# RATE_LIMIT_QUOTES=60
# RATE_LIMIT_QUOTES_DECAY=1
# RATE_LIMIT_MANAGE_LOOKUP=10
# RATE_LIMIT_MANAGE_LOOKUP_DECAY=15
# RATE_LIMIT_MANAGE_REQUESTS=5
# RATE_LIMIT_MANAGE_REQUESTS_DECAY=15
# RATE_LIMIT_CHECKOUT=10
# RATE_LIMIT_CHECKOUT_DECAY=15
# RATE_LIMIT_WEBHOOK=120
# RATE_LIMIT_WEBHOOK_DECAY=1
# External Third-Party API Quotas & Rate Limits
# PAYMONGO_MAX_REQ_PER_MIN=60
# PAYMONGO_CACHE_TTL=300
# PAYMONGO_MAX_RETRIES=2
# PAYMONGO_BACKOFF_BASE_MS=500
# PAYMONGO_TIMEOUT_SECONDS=15
# OPEN_METEO_MAX_REQ_PER_MIN=60
