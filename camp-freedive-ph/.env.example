# OPEN_METEO_MASTER_CACHE_HOURS=6
# OPEN_METEO_DATE_CACHE_MINS=60
# OPEN_METEO_MAX_RETRIES=2
# OPEN_METEO_BACKOFF_BASE_MS=300
# OPEN_METEO_TIMEOUT_SECONDS=10
